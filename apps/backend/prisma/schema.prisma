generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Offer {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  category    String
  tag         String    @default("")
  color       String    @default("emerald")
  description String
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String           @id @default(cuid())
  offerId     String
  offer       Offer            @relation(fields: [offerId], references: [id])
  slug        String           @unique
  name        String
  priceFcfa   Int
  description String
  features    String[]
  published   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  orderItems  OrderItem[]
  variants    ProductVariant[]
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  color       String   @default("emerald")
  description String?
  fileName    String? // nom original du fichier .xlsx
  filePath    String? // chemin de stockage interne (jamais expose au client)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING)
  totalFcfa  Int
  paymentRef String? // reference retournee par l'agregateur de paiement
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  priceFcfa      Int // prix fige au moment de l'achat
  downloadTokens DownloadToken[]
}

model DownloadToken {
  token       String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}
